# Credentials file: --passwords, or "passwords_file" in servers.json, or ./.passwords. chmod 600.
# Each server uses the entry named by its "credentials_key" (default: the server key).
# The value decides the type: "d2pat_..." is a token, "user:password" is basic auth.
dev_post='d2pat_xxxxxxxx'
prod-1='admin:change-me'
# Or user and password as two entries, and "credentials_key": "demo_user;demo_pass"
demo_user=admin
demo_pass=change-me
